    {
      "name": "接続 -- 中止",
      "projectName": "接続",
      "note": "CANCEL. Stops the transfer at once, then puts the phone back exactly as it was: WiFi to its pre-test state and mobile data to the SIM that was carrying it before the test started (%Setsuzoku_PreDataSlot, captured at the top of every measurement).",
      "actions": [
        {
          "type": "net.speedtest.cancel",
          "label": "Abort the running transfer immediately",
          "args": {}
        },
        {
          "type": "scene.hide",
          "label": "Close the live overlay",
          "args": {
            "scene": "接続 測定中"
          }
        },
        {
          "type": "sim.data.set",
          "label": "Restore the data SIM that was active before the test",
          "args": {
            "slot": "%Setsuzoku_PreDataSlot",
            "settle_ms": "500"
          }
        },
        {
          "type": "flow.if",
          "label": "Restore WiFi unless it was positively OFF (fail-safe)",
          "args": {
            "condition": "%Setsuzoku_WifiWas != false"
          }
        },
        {
          "type": "wifi.toggle",
          "label": "WiFi back on",
          "args": {
            "state": "on"
          }
        },
        {
          "type": "flow.endif",
          "label": "end",
          "args": {}
        },
        {
          "type": "flash",
          "label": "Confirm to 白い熊",
          "args": {
            "text": "接続 — 中止しました（WiFi と SIM を復元）"
          }
        }
      ]
    }
  ],
