    {
      "name": "接続 -- 三重",
      "projectName": "接続",
      "note": "TRIPLE test: WiFi + both SIMs.\n\nThe WiFi leg runs FIRST, deliberately — it is the only moment WiFi is still connected. Once it is measured the radio goes off for the two SIM legs, then everything is restored. Doing it in any other order would mean toggling WiFi twice.",
      "actions": [
        {
          "type": "state.get",
          "label": "Remember WiFi state",
          "args": {
            "wifi": "Setsuzoku_WifiWas"
          }
        },
        {
          "type": "flash",
          "label": "Say what is being measured",
          "args": {
            "text": "WiFi を測定中…"
          }
        },
        {
          "type": "scene.show",
          "label": "Live overlay — sticky (a stray touch must not kill a running test)",
          "args": {
            "scene": "接続 測定中",
            "dismissOnOutside": "false",
            "keepScreenOn": "true"
          }
        },
        {
          "type": "net.speedtest",
          "label": "WiFi leg — measured over the CURRENT default route, no binding needed",
          "args": {
            "transport": "wifi",
            "direction": "both",
            "seconds": "%Setsuzoku_Secs",
            "streams": "%Setsuzoku_Streams",
            "ramp_ms": "%Setsuzoku_RampMs",
            "prefix": "SPD_"
          }
        },
        {
          "type": "scene.hide",
          "label": "Close overlay",
          "args": {
            "scene": "接続 測定中"
          }
        },
        {
          "type": "var.set",
          "label": "Keep the WiFi figures under leg 'w'",
          "args": {
            "name": "Setsuzoku_SwDown",
            "value": "%SPD_DownAvg"
          }
        },
        {
          "type": "var.set",
          "label": "…upload",
          "args": {
            "name": "Setsuzoku_SwUp",
            "value": "%SPD_UpAvg"
          }
        },
        {
          "type": "var.set",
          "label": "…latency",
          "args": {
            "name": "Setsuzoku_SwMs",
            "value": "%SPD_DownMs"
          }
        },
        {
          "type": "var.set",
          "label": "…peak",
          "args": {
            "name": "Setsuzoku_SwPeak",
            "value": "%SPD_DownPeak"
          }
        },
        {
          "type": "var.set",
          "label": "…server",
          "args": {
            "name": "Setsuzoku_SwHost",
            "value": "%SPD_DownHost"
          }
        },
        {
          "type": "var.set",
          "label": "…label",
          "args": {
            "name": "Setsuzoku_SwName",
            "value": "WiFi"
          }
        },
        {
          "type": "wifi.toggle",
          "label": "Now drop WiFi so each SIM can be the default route",
          "args": {
            "state": "off"
          }
        },
        {
          "type": "flow.wait",
          "label": "Let cellular take over",
          "args": {
            "millis": "4000"
          }
        },
        {
          "type": "task.run",
          "label": "SIM1",
          "args": {
            "task": "接続 -- 一枚測定",
            "param:slot": "0",
            "param:name": "%Setsuzoku_Sim0Name",
            "param:color": "%Setsuzoku_Sim0Color"
          }
        },
        {
          "type": "task.run",
          "label": "SIM2",
          "args": {
            "task": "接続 -- 一枚測定",
            "param:slot": "1",
            "param:name": "%Setsuzoku_Sim1Name",
            "param:color": "%Setsuzoku_Sim1Color"
          }
        },
        {
          "type": "sim.data.set",
          "label": "Data back to SIM1",
          "args": {
            "slot": "0",
            "settle_ms": "1000"
          }
        },
        {
          "type": "flow.if",
          "label": "Restore WiFi unless it was positively OFF beforehand (fail-safe: unknown → restore)",
          "args": {
            "condition": "%Setsuzoku_WifiWas != false"
          }
