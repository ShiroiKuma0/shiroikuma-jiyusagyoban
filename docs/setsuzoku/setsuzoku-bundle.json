        },
        {
          "type": "flow.endif",
          "label": "end",
          "args": {}
        },
        {
          "type": "var.set",
          "label": "Report all three legs",
          "args": {
            "name": "Setsuzoku_Legs",
            "value": "w,0,1"
          }
        },
        {
          "type": "scene.show",
          "label": "Final report",
          "args": {
            "scene": "接続 報告"
          }
        }
      ]
    },
    {
      "name": "接続 -- 自動判定",
      "projectName": "接続",
      "note": "BLIND wrapper — the one to reach for when you do not want to think about it.\n\nWiFi on  → triple test (WiFi + both SIMs).\nWiFi off → dual test (both SIMs only), because there is no WiFi to measure.\n\nIt decides from the live radio state, not from what was true last time.",
      "actions": [
        {
          "type": "state.get",
          "label": "What is WiFi doing right now?",
          "args": {
            "wifi": "wifinow"
          }
        },
        {
          "type": "flow.if",
          "label": "WiFi is on → measure it too",
          "args": {
            "condition": "%wifinow == true"
          }
        },
        {
          "type": "task.run",
          "label": "Triple test",
          "args": {
            "task": "接続 -- 三重"
          }
        },
        {
          "type": "flow.else",
          "label": "else",
          "args": {}
        },
        {
          "type": "task.run",
          "label": "Dual test — nothing to measure on WiFi",
          "args": {
            "task": "接続 -- 両SIM"
          }
        },
        {
          "type": "flow.endif",
          "label": "end",
          "args": {}
        }
