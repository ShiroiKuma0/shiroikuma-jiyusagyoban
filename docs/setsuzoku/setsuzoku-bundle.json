    {
      "name": "接続 -- 現在のSIM",
      "projectName": "接続",
      "note": "Whichever SIM currently carries data — no switching at all, so it is the quickest check and the one that cannot disturb your SIM setup. The dialog and the report still name the SIM being tested, read live from the system rather than assumed.",
      "actions": [
        {
          "type": "state.get",
          "label": "Remember whether WiFi was on, so it can be put back exactly as found",
          "args": {
            "wifi": "Setsuzoku_WifiWas"
          }
        },
        {
          "type": "wifi.toggle",
          "label": "WiFi OFF — cellular can only be measured as the DEFAULT route; EMUI refuses per-network socket binding (EPERM)",
          "args": {
            "state": "off"
          }
        },
        {
          "type": "flow.wait",
          "label": "Let the cellular route actually take over before measuring",
          "args": {
            "millis": "4000"
          }
        },
        {
          "type": "sim.list",
          "label": "Read which slot currently carries data, and both carrier names",
          "args": {
            "prefix": "SIM_"
          }
        },
        {
          "type": "var.set",
          "label": "Use the live slot as the leg index",
          "args": {
            "name": "cur",
            "value": "%SIM_DataSlot"
          }
        },
        {
          "type": "flow.if",
          "label": "Slot 0 → SIM1's name and colour",
          "args": {
            "condition": "%cur == 0"
          }
        },
        {
          "type": "var.set",
          "label": "SIM1 name",
          "args": {
            "name": "curname",
            "value": "%Setsuzoku_Sim0Name"
          }
        },
        {
          "type": "var.set",
          "label": "SIM1 colour",
          "args": {
            "name": "curcolor",
            "value": "%Setsuzoku_Sim0Color"
          }
        },
        {
          "type": "flow.else",
          "label": "else slot 1",
          "args": {}
        },
        {
          "type": "var.set",
          "label": "SIM2 name",
          "args": {
            "name": "curname",
            "value": "%Setsuzoku_Sim1Name"
          }
        },
        {
          "type": "var.set",
          "label": "SIM2 colour",
          "args": {
            "name": "curcolor",
            "value": "%Setsuzoku_Sim1Color"
          }
        },
        {
          "type": "flow.endif",
          "label": "end",
          "args": {}
        },
        {
          "type": "task.run",
          "label": "Measure the SIM already carrying data — no switching",
          "args": {
            "task": "接続 -- 一枚測定",
            "param:slot": "%cur",
            "param:name": "%curname",
            "param:color": "%curcolor"
          }
        },
        {
          "type": "flow.if",
          "label": "Restore WiFi unless it was positively OFF beforehand (fail-safe: unknown → restore)",
          "args": {
