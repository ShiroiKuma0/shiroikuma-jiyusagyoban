  "tasks": [
    {
      "name": "接続の設定",
      "projectName": "接続",
      "note": "SETTINGS for the whole 接続 project. Everything tunable lives here and nowhere else — edit a value, run this task once, and every measurement task picks it up.\n\nSIM identity is addressed by SLOT (0 = SIM1, 1 = SIM2), never by subscription id: this phone already carries five subIds for two physical SIMs, left over from earlier insertions, so a hardcoded id breaks the next time a SIM is reseated.\n\nVariables are %Setsuzoku_* — leading uppercase, so they are persisted globals the scenes can read.",
      "actions": [
        {
          "type": "var.set",
          "label": "SIM1 (slot 0) display name",
          "args": {
            "name": "Setsuzoku_Sim0Name",
            "value": "T-Mobile"
          }
        },
        {
          "type": "var.set",
          "label": "SIM1 colour — dark red, used in dialogs, scenes and the report",
          "args": {
            "name": "Setsuzoku_Sim0Color",
            "value": "#880000"
          }
        },
        {
          "type": "var.set",
          "label": "SIM2 (slot 1) display name — subscript two, as 白い熊 asked",
          "args": {
            "name": "Setsuzoku_Sim1Name",
            "value": "O₂"
          }
        },
        {
          "type": "var.set",
          "label": "SIM2 colour — blue",
          "args": {
            "name": "Setsuzoku_Sim1Color",
            "value": "#0000FF"
          }
        },
        {
          "type": "var.set",
          "label": "WiFi leg colour, for the triple test",
          "args": {
            "name": "Setsuzoku_WifiColor",
            "value": "#00AA55"
          }
        },
        {
          "type": "var.set",
          "label": "Seconds per leg. The CLOCK is the limiter, as in Ookla — not a byte count",
          "args": {
            "name": "Setsuzoku_Secs",
            "value": "10"
          }
        },
        {
          "type": "var.set",
          "label": "Parallel streams. One TCP stream is capped by window/RTT and under-reports a fast link",
          "args": {
            "name": "Setsuzoku_Streams",
            "value": "8"
          }
        },
        {
          "type": "var.set",
          "label": "Milliseconds of TCP slow-start excluded from the headline average",
          "args": {
            "name": "Setsuzoku_RampMs",
            "value": "2000"
          }
        },
        {
          "type": "var.set",
          "label": "Modem settle after a SIM switch, before measuring — or the first samples time the handover",
          "args": {
            "name": "Setsuzoku_SettleMs",
            "value": "4000"
          }
        },
        {
          "type": "flash",
          "label": "Confirm",
          "args": {
            "text": "接続の設定 ✓  %Setsuzoku_Sim0Name / %Setsuzoku_Sim1Name — %Setsuzoku_Secs s × %Setsuzoku_Streams streams"
          }
        }
      ]
    },
    {
      "name": "接続 -- 一枚測定",
      "projectName": "接続",
      "note": "CORE measurement for ONE SIM. Called with param slot (0 or 1); not meant to be run directly — the wrappers below set the parameter.\n\nAssumes WiFi is already off (the caller owns that): per-network binding is refused by EMUI with EPERM, so cellular can only be measured by being the default route.\n\nResults land in %Setsuzoku_S<slot>* so both SIMs' figures survive side by side for the report.",
      "actions": [
        {
          "type": "sim.list",
          "label": "Record the pre-test data slot so Cancel can restore it",
          "args": {
            "prefix": "Setsuzoku_Pre"
          }
        },
        {
          "type": "var.set",
          "label": "Publish as a GLOBAL — scenes cannot see task-local variables",
          "args": {
            "name": "Setsuzoku_CurSlot",
            "value": "{{ param.slot }}"
          }
        },
        {
          "type": "var.set",
          "label": "Publish as a GLOBAL — scenes cannot see task-local variables",
          "args": {
            "name": "Setsuzoku_CurName",
            "value": "{{ param.name }}"
          }
        },
        {
          "type": "var.set",
          "label": "Publish as a GLOBAL — scenes cannot see task-local variables",
          "args": {
            "name": "Setsuzoku_CurColor",
            "value": "{{ param.color }}"
          }
        },
        {
          "type": "flash",
          "label": "Say which SIM is being tested — 白い熊 must always see this",
          "args": {
            "text": "%Setsuzoku_CurName を測定中…"
          }
        },
        {
          "type": "sim.data.set",
          "label": "Point mobile data at this slot (Shizuku → ISub.setDefaultDataSubId)",
          "args": {
            "slot": "%Setsuzoku_CurSlot",
            "settle_ms": "%Setsuzoku_SettleMs",
            "store_previous": "Setsuzoku_PrevSlot"
          }
        },
        {
          "type": "scene.show",
          "label": "Live overlay — sticky (a stray touch must not kill a running test)",
          "args": {
            "scene": "接続 測定中",
            "dismissOnOutside": "false",
            "keepScreenOn": "true"
          }
        },
        {
          "type": "net.speedtest",
          "label": "Measure this SIM: nearest Ookla server, both directions",
          "args": {
            "transport": "cellular",
            "direction": "both",
            "seconds": "%Setsuzoku_Secs",
            "streams": "%Setsuzoku_Streams",
            "ramp_ms": "%Setsuzoku_RampMs",
            "prefix": "SPD_"
          }
        },
        {
          "type": "scene.hide",
          "label": "Close the live overlay",
          "args": {
            "scene": "接続 測定中"
          }
        },
        {
          "type": "var.set",
          "label": "Keep this SIM's download figure",
          "args": {
            "name": "Setsuzoku_S{{ param.slot }}Down",
            "value": "%SPD_DownAvg"
          }
        },
        {
          "type": "var.set",
          "label": "…upload",
          "args": {
            "name": "Setsuzoku_S{{ param.slot }}Up",
            "value": "%SPD_UpAvg"
          }
        },
        {
          "type": "var.set",
          "label": "…latency (time to first byte)",
          "args": {
            "name": "Setsuzoku_S{{ param.slot }}Ms",
            "value": "%SPD_DownMs"
          }
        },
        {
          "type": "var.set",
          "label": "…peak download",
          "args": {
            "name": "Setsuzoku_S{{ param.slot }}Peak",
            "value": "%SPD_DownPeak"
          }
        },
        {
          "type": "var.set",
          "label": "…which server served it. Non-empty %SPD_DownFallback means the nearest server was NOT used and the figure is not comparable",
          "args": {
            "name": "Setsuzoku_S{{ param.slot }}Host",
            "value": "%SPD_DownHost"
          }
        },
        {
          "type": "var.set",
          "label": "…and the name, so the report can label it",
          "args": {
            "name": "Setsuzoku_S{{ param.slot }}Name",
            "value": "%Setsuzoku_CurName"
          }
        }
      ]
    },
    {
      "name": "接続 -- 両SIM",
      "projectName": "接続",
      "note": "DUAL test: both SIMs, one after the other. This is the main task — make the home-screen shortcut point here.\n\nSequence: remember WiFi → WiFi off → SIM1 → SIM2 → data back to SIM1 → WiFi back as found → report.\n\nWiFi is switched off because EMUI refuses to let this app bind a socket to a non-default network (EPERM), so a SIM can only be measured while it IS the default route. Its previous state is captured first and restored at the end.",
      "actions": [
        {
          "type": "state.get",
          "label": "Remember whether WiFi was on, so it can be put back exactly as found",
          "args": {
            "wifi": "Setsuzoku_WifiWas"
          }
        },
        {
          "type": "wifi.toggle",
          "label": "WiFi OFF — cellular can only be measured as the DEFAULT route; EMUI refuses per-network socket binding (EPERM)",
          "args": {
            "state": "off"
          }
        },
        {
          "type": "flow.wait",
          "label": "Let the cellular route actually take over before measuring",
          "args": {
            "millis": "4000"
          }
        },
        {
          "type": "task.run",
          "label": "SIM1",
          "args": {
            "task": "接続 -- 一枚測定",
            "param:slot": "0",
            "param:name": "%Setsuzoku_Sim0Name",
            "param:color": "%Setsuzoku_Sim0Color"
          }
        },
        {
          "type": "task.run",
          "label": "SIM2",
          "args": {
            "task": "接続 -- 一枚測定",
            "param:slot": "1",
            "param:name": "%Setsuzoku_Sim1Name",
            "param:color": "%Setsuzoku_Sim1Color"
          }
        },
        {
          "type": "sim.data.set",
          "label": "Put mobile data back on SIM1 — 白い熊's normal SIM. Runs even after a failed leg",
          "args": {
            "slot": "0",
            "settle_ms": "1000"
          }
        },
        {
          "type": "flow.if",
          "label": "Restore WiFi unless it was positively OFF beforehand (fail-safe: unknown → restore)",
          "args": {
            "condition": "%Setsuzoku_WifiWas != false"
          }
        },
        {
          "type": "wifi.toggle",
          "label": "Restore WiFi",
          "args": {
            "state": "on"
          }
        },
        {
          "type": "flow.endif",
          "label": "end",
          "args": {}
        },
        {
          "type": "var.set",
          "label": "Mark which legs the report should show",
          "args": {
            "name": "Setsuzoku_Legs",
            "value": "0,1"
          }
        },
        {
          "type": "scene.show",
          "label": "Final report",
          "args": {
            "scene": "接続 報告"
          }
        }
      ]
    },
    {
