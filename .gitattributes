# Every text file is stored LF. Editing tools on this project write LF, so a
# CRLF-committed file turns a one-bullet change into a whole-file diff and makes
# git blame useless: CHANGELOG.md had already drifted to mixed endings before
# this policy existed.
* text=auto eol=lf

# cmd.exe is only dependable with CRLF, so batch files are checked out CRLF
# while still being stored LF like everything else.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jar binary
*.apk binary
*.aar binary
*.jks binary
*.keystore binary
*.p12 binary
*.so binary
*.zip binary
*.gz binary

# --- shiroikuma fork ---------------------------------------------------------
# GNSS captures are BYTES, not text. `current_yuma.alm` from NavCen and the IAC's
# `MCCT_*.agl` arrive with CRLF, and these fixtures exist to be exactly what those servers send —
# a fixture normalised to LF is testing something the pipeline will never receive. `text=auto`
# classifies them as text because they happen to be ASCII, so they are pinned here instead.
*.alm -text
*.agl -text
