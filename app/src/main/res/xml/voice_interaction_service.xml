<?xml version="1.0" encoding="utf-8"?>
<!-- supportsAssist is what lets Android offer RuleDeck as the digital assistant app. -->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:recognitionService="com.sysadmindoc.ruledeck.core.assistant.RuleDeckRecognitionService"
    android:sessionService="com.sysadmindoc.ruledeck.core.assistant.RuleDeckVoiceSessionService"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="false" />
