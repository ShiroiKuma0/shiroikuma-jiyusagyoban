<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        windowBackground is what the splash and the pre-composition window paint. Hardcoding black
        meant every Light-mode launch flashed black before Compose drew the cream surface. The
        night variant keeps black; see values-night/themes.xml.
    -->
    <style name="Theme.OpenTasker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
