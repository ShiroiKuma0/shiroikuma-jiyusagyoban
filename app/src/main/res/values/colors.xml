<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget colours mirror the app's light graphite/sage palette (ui/theme/Theme.kt). The dark
    variant lives in values-night. They used to be the retired Catppuccin Mocha palette and were
    permanently dark, so the one surface a user sees without opening the app was the only one that
    never matched it.
-->
<resources>
    <color name="widget_background">#FBFAF6</color>
    <color name="widget_border">#89928A</color>
    <color name="widget_primary">#4D6653</color>
    <color name="widget_text_primary">#20241F</color>
    <color name="widget_text_secondary">#606960</color>
    <!-- Splash and pre-composition window fill. Matches LightBase in ui/theme/Theme.kt. -->
    <color name="window_background">#F4F2EC</color>
    <!-- Notification accent; the sage primary shared with the widget. -->
    <color name="notification_accent">#4D6653</color>
</resources>
