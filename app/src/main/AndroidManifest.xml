<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"
        tools:targetApi="36" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- system.set_locale: dev-flagged, so adb-grantable once (pm grant, survives reboots). -->
    <uses-permission
        android:name="android.permission.CHANGE_CONFIGURATION"
        tools:ignore="ProtectedPermissions" />
    <!-- system.set_locale: updatePersistentConfiguration also enforces the WRITE_SETTINGS appop
         (adb: appops set … WRITE_SETTINGS allow, or the "modify system settings" toggle). -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Speed test: pins its own cellular/WiFi network with requestNetwork so a mobile leg can run
         while WiFi stays connected. It never changes the system default route. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Reading the SIM slots (carrier name + subscription id) for the 接続 speed tests. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission
        android:name="${smsPermissionName}" />
    <uses-permission
        android:name="${smsReceivePermissionName}" />
    <uses-permission
        android:name="${smsMmsPermissionName}"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="${smsWapPushPermissionName}"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="${phoneStatePermissionName}" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
        Special access, granted only through Settings > Modify system settings. Required by the
        brightness.set and screen.timeout actions, which advertise it as their setup requirement;
        without the declaration Settings.System.canWrite() can never become true and both actions
        would fail forever while claiming to be one grant away.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!--
        Special access, granted only through Settings > Notifications > Do Not Disturb access
        (renamed "Modes access" on Android 16). The system builds that list from apps that
        declare this permission, so without it OpenTasker never appears on the page, the
        isNotificationPolicyAccessGranted() checks behind dnd.set / zen.rule.set / zen.rule.clear
        can never become true, and the Setup row sends the user to a screen that cannot grant
        anything (issue #4).
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <permission
        android:name="com.opentasker.permission.AUTOMATION"
        android:description="@string/permission_automation_description"
        android:label="@string/permission_automation_label"
        android:protectionLevel="signature" />

    <queries>
        <!-- Sister apps: token-gated automation intents driven by the Send Intent action. -->
        <package android:name="shiroikuma.jami" />
        <package android:name="shiroikuma.renrakusaki" />
        <!-- 白い熊 地図 (OsmAnd fork): a speed-test history row opens its fix with
             VIEW geo:<lat>,<lon>, handled by net.osmand.plus.activities.search.GeoIntentActivity. -->
        <package android:name="shiroikuma.chizu" />
        <!--
          Broad visibility for the generic Send Intent action. Package visibility is
          all-or-nothing per package, so matching any launchable app's MAIN/LAUNCHER
          entry exposes every component of that package — letting Send Intent dispatch
          to any normal app's activities/services/receivers on Android 11+. Targets
          with no launcher entry, or reachable only by a custom action string, still
          need their own <package> pin (e.g. shiroikuma.jami above).
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.termux" />
        <!-- Both Shizuku managers: 白い熊's fork is the one actually installed; upstream's id is kept
             so a stock install still resolves. Without these pins getLaunchIntentForPackage answers
             null on Android 11+ and "Open Shizuku settings" falls through to the setup web page. -->
        <package android:name="shiroikuma.shizuku" />
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Scoped visibility for the shared installed-app picker; QUERY_ALL_PACKAGES is forbidden. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
        </intent>
        <intent>
            <action android:name="com.twofortyfouram.locale.intent.action.EDIT_CONDITION" />
        </intent>
        <intent>
            <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
        </intent>
        <intent>
            <action android:name="com.twofortyfouram.locale.intent.action.QUERY_CONDITION" />
        </intent>
        <intent>
            <action android:name="com.twofortyfouram.locale.intent.action.REQUEST_QUERY" />
        </intent>
    </queries>

    <application
        android:name=".OpenTaskerApp_NoHilt"
        android:label="@string/app_name"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.OpenTasker"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="s">

        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <!--
            singleTop is required for the NFC filter below, not a preference. Manifest NFC dispatch
            delivers a tag to a standard-launchMode activity by starting a *new* instance, so
            onNewIntent never ran and every tap stacked another copy of the app: the armed tag-write
            editor stayed buried in the back stack while its result was delivered to the instance
            the user could no longer see.
        -->
        <activity
            android:name="com.opentasker.progress.ProgressPanelActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".progress"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:theme="@style/Theme.OpenTasker" />

        <!--
            健康 — the band charts, in their own window rather than a tab (白い熊, 2026-08-03).
            Its own taskAffinity so it is a separate entry in recents from the automation editor:
            opening the charts from a launcher shortcut must not drag 自由作業盤's back stack along.
        -->
        <activity
            android:name="com.opentasker.ui.charts.BandChartsActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".band"
            android:label="健康"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:theme="@style/Theme.OpenTasker" />

        <!-- The second band's report, in its OWN window with its own taskAffinity: a launcher
             shortcut to one band never resumes the other's, and retiring one later is a deletion
             rather than surgery on a live window. -->
        <activity
            android:name="com.opentasker.ui.charts.huawei.HuaweiChartsActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".huawei"
            android:label="健康（Huawei）"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:theme="@style/Theme.OpenTasker" />

        <!-- The watch-face library as its own window: its Install buttons run for tens of
             seconds over Bluetooth and the picker has to still be there afterwards, which a
             dialog's launch-settle-finish contract cannot offer. -->
        <activity
            android:name="com.opentasker.ui.charts.huawei.HuaweiFacesActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".watchfaces"
            android:label="文字盤（Huawei）"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:theme="@style/Theme.OpenTasker" />

        <!-- The appearance settings as their own window, so 「文字認識」 can send 白い熊 to its knobs
             and the system back stack brings them back to the screenshot. Not exported. -->
        <activity
            android:name="com.opentasker.ui.screens.UiCustomizationActivity"
            android:exported="false"
            android:label="白い熊 自由作業盤 UI"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:theme="@style/Theme.OpenTasker" />

        <!-- 文字認識: the OCR review window. Opened by the share tile below, never exported — the only
             way in is a screenshot we have already copied into our own cache. -->
        <activity
            android:name="com.opentasker.ui.ocr.OcrReviewActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".ocr"
            android:label="文字認識"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:theme="@style/Theme.OpenTasker" />

        <!-- 記事変換: the article window — the page list, the model choice, the two progress bars and
             the cancel. Not exported; the way in is the ocr.article action with "Open the window" on.
             Deliberately NOT given a Sharesheet tile: EMUI collapses the share grid to one tile per
             package, so a second one would compete with 文字認識 rather than sit beside it. -->
        <activity
            android:name="com.opentasker.ui.article.ArticleBuildActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".article"
            android:label="記事変換"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:theme="@style/Theme.OpenTasker" />

        <!-- 記事編集: the article against the screenshots it was read from. windowSoftInputMode is
             adjustResize so the ime inset is REPORTED, but the window draws edge to edge and is never
             actually resized by it — the screen translates itself instead, so the page strip keeps its
             scroll position while typing. Not exported. -->
        <activity
            android:name="com.opentasker.ui.article.ArticleEditActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".article"
            android:label="記事編集"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:theme="@style/Theme.OpenTasker" />

        <!-- 文字認識: its own Sharesheet tile, images ONLY. Kept separate from ShareReceiverActivity
             (which accepts every MIME type and feeds the automation engine) so sharing a screenshot
             here means "read the text in this", not "run a task". It copies the bytes and finishes —
             see the URI-grant note in OcrShareActivity. -->
        <activity
            android:name="com.opentasker.core.ocr.OcrShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:grantUriPermissions="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="文字認識"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:theme="@style/Theme.OpenTasker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.opentasker.core.contexts.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:grantUriPermissions="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.opentasker.core.actions.ContactPickerActivity"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Per-app share targets: the internal handler each generated relay APK forwards into. It
             unfreezes the picked frozen app (Shizuku) and forwards the shared content to it, then
             drops a re-freeze bubble. Exported (no permission) so an external relay can call it by
             explicit component; it deliberately has NO SEND intent-filter, so the main app itself is
             not a share-sheet tile — only the per-target relays are. -->
        <activity
            android:name="com.opentasker.core.share.ShareForwardActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- The "Share apps" screen (relay generator), opened by the share.relays action. -->
        <activity
            android:name="com.opentasker.core.share.ShareAppsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <service
            android:name="com.opentasker.core.engine.AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="白い熊 自由作業盤 automation engine — runs user-defined profiles when their contexts match" />
        </service>

        <service
            android:name="com.opentasker.core.contexts.NotificationTriggerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name="com.opentasker.core.contexts.CompanionPresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.opentasker.core.engine.BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.opentasker.core.engine.DirectBootTimeReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.opentasker.action.DIRECT_BOOT_TIME_TICK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.opentasker.core.contexts.SmsReceivedReceiver"
            android:enabled="${smsTriggerEnabled}"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_RECEIVED" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.opentasker.core.admin.DeviceAdmin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.opentasker.automation.receiver.TimeEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.opentasker.automation.TIME_TICK" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.opentasker.core.scenes.SceneOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Scene overlay — displays user-defined floating UI panels" />
        </service>

        <service
            android:name="com.opentasker.core.contexts.QuickSettingsTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_compass"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.opentasker.core.contexts.QuickSettingsTileServiceSlot2"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_compass"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.opentasker.core.contexts.QuickSettingsTileServiceSlot3"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_compass"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.opentasker.core.contexts.QuickSettingsTileServiceSlot4"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_compass"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name="com.opentasker.core.contexts.QuickSettingsTileConfigActivity"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:theme="@style/Theme.OpenTasker">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- exported: a third-party launcher (e.g. 白い熊 雷起動盤) fires the raw shortcut intent itself,
             so the run-task trampoline must be startable from another app. -->
        <activity
            android:name="com.opentasker.widget.TaskRunActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- Launcher "add a shortcut" entry: picks a task, returns a home-screen shortcut that runs it. -->
        <activity
            android:name="com.opentasker.widget.CreateTaskShortcutActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.opentasker.scenes.SceneActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
