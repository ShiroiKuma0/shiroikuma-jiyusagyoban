# EXCEPTION: the share-relay stub's prebuilt dex is a committed fixture (see app/src/relay/REGENERATE.md),
# not a build output — it ships in the APK as an asset the on-device relay generator reuses verbatim.
!app/src/main/assets/relay/classes.dex

# Keystores (NEVER commit)
*.jks
*.keystore
keystore.properties

# Kotlin
.kotlin/

# Local agent working notes
CODEX_CHANGELOG.md
*.bak
AUDIT_COMPLETE.md
PHASE_5_CHECKPOINT.md
build.log
buildlog.txt
build_output.txt
build_*.bat
build.sh

# shiroikuma fork: CLAUDE.md, .claude/skills, .md docs and hand-off.md ARE committed, so
# upstream's blanket `*.md` rule — and the `docs/` rule that came with it — are deliberately NOT
# taken: our documentation is the fork's working memory and belongs in the history. Only
# host-specific local Claude settings stay out.
.claude/settings.local.json

# AI config for tools this fork does not use.
AGENTS.md
.codex/
.ai/
PROJECT_CONTEXT.md
CONTINUATION_PROMPT.md

# The self-host signing identity is deliberately tracked: it is not a private
# code-signing certificate, and keeping it in the repo is what stops the signing
# identity from being lost when a machine-global debug keystore is regenerated.
# (Upstream's; our own release signing comes from the gitignored keystore.properties.)
!app/dev_keystore.jks

# Compose screenshot references are intentional source assets. Reports, diffs, and transient
# rendered images remain local build output and must not become review noise.
app/src/screenshotTest*/actual/
app/src/screenshotTest*/diff/

# Claude's scratch space: generator/demo/sim scripts and their JSON output live here
# (never in ~/tmp — that's 白い熊's). Pushed to the device's /sdcard/tmp/ from here.
.scratch/
app/src/main/assets/ocr/
